{
  "name": "@trupu/server",
  "version": "0.1.0",
  "type": "module",
  "description": "Trusted Publishing for Docker registries using GitHub Actions OIDC",
  "license": "MIT",
  "keywords": [
    "docker",
    "registry",
    "oidc",
    "trusted-publishing",
    "github-actions",
    "traefik",
    "forward-auth",
    "authentication"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nmerget/trupu.git",
    "directory": "packages/server"
  },
  "main": "dist/index.js",
  "bin": {
    "trupu": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node esbuild.config.js",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.5",
    "jose": "6.2.10"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
